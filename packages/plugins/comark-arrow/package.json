{
  "name": "comark-arrow",
  "version": "0.1.0",
  "description": "Comark plugin for ArrowJS sandboxed widgets — agent-authored UI with no upfront component registration.",
  "comark": {
    "headline": "Arrow",
    "tagline": "Sandboxed ArrowJS widgets for Comark.",
    "install": "npm i comark-arrow @arrow-js/sandbox"
  },
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "arrow-js",
    "arrow",
    "sandbox",
    "quickjs",
    "vue"
  ],
  "homepage": "https://github.com/miguelrk/comark-arrow#readme",
  "bugs": {
    "url": "https://github.com/miguelrk/comark-arrow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelrk/comark-arrow.git"
  },
  "author": "Miguel Romero Karam",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.mts",
      "default": "./dist/vue/index.mjs"
    },
    "./html": {
      "types": "./dist/html.d.mts",
      "default": "./dist/html.mjs"
    },
    "./ansi": {
      "types": "./dist/ansi.d.mts",
      "default": "./dist/ansi.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "tsx playground/index.ts",
    "play:nuxt": "pnpm --filter comark-arrow-playground dev",
    "og:generate": "pnpm --filter comark-arrow-playground og:generate",
    "prepack": "npm run build",
    "release": "release-it",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@arrow-js/sandbox": "1.0.6",
    "comark": ">=0.4.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@arrow-js/sandbox": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arrow-js/sandbox": "1.0.6",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "comark": "catalog:",
    "happy-dom": "^20.0.0",
    "rangi": "catalog:",
    "release-it": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "pnpm typecheck",
        "pnpm test"
      ]
    },
    "git": {
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true
    }
  }
}
