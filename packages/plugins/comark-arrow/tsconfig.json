{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "paths": {
      "@arrow-js/sandbox": ["./src/shims/arrow-js-sandbox.d.ts"]
    }
  },
  "include": ["src", "test", "playground/index.ts"],
  "exclude": ["node_modules", "dist", "playground/.nuxt"]
}
