{
  "name": "comark-email",
  "version": "0.2.0",
  "description": "Email renderer for Comark. Convert Markdown to responsive, MJML-compiled HTML for email clients.",
  "comark": {
    "headline": "Email renderer",
    "tagline": "Convert Markdown to responsive, MJML-compiled email HTML — parse-time, Node-only.",
    "install": "npm i comark-email"
  },
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "email",
    "mjml",
    "renderer",
    "transactional",
    "html"
  ],
  "homepage": "https://miguelrk.github.io/comark-packages/comark-email/",
  "bugs": {
    "url": "https://github.com/miguelrk/comark-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelrk/comark-packages.git",
    "directory": "packages/comark-email"
  },
  "author": "Miguel Romero Karam",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./render": {
      "types": "./dist/render.d.mts",
      "default": "./dist/render.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "tsx playground/index.ts",
    "play:nuxt": "pnpm --filter comark-email-playground dev",
    "og:generate": "pnpm --filter comark-email-playground og:generate",
    "prepack": "npm run build",
    "release": "release-it",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@comark/html": ">=0.7.0",
    "comark": ">=0.4.0"
  },
  "dependencies": {
    "mjml": "^5.0.0"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@types/mjml": "^5.0.0",
    "@types/node": "catalog:",
    "comark": "catalog:",
    "release-it": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "pnpm typecheck",
        "pnpm test"
      ]
    },
    "git": {
      "commitMessage": "chore(release): ${npm.name}@${version}",
      "tagName": "${npm.name}@${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": true,
      "releaseName": "${npm.name}@${version}"
    },
    "npm": {
      "publish": true
    }
  }
}
