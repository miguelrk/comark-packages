{
  "name": "comark-pdf",
  "version": "0.1.0",
  "description": "PDF renderer for Comark. Convert Markdown to print-ready PDF bytes via jasy — no headless browser required.",
  "comark": {
    "headline": "PDF renderer",
    "tagline": "Render Comark documents to PDF bytes via jasy.",
    "install": "npm i comark-pdf"
  },
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "pdf",
    "renderer"
  ],
  "homepage": "https://miguelrk.github.io/comark-packages/comark-pdf/",
  "bugs": {
    "url": "https://github.com/miguelrk/comark-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelrk/comark-packages.git",
    "directory": "packages/comark-pdf"
  },
  "author": "Miguel Romero Karam",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./preview": {
      "types": "./dist/preview.d.mts",
      "default": "./dist/preview.mjs"
    },
    "./render": {
      "types": "./dist/render.d.mts",
      "default": "./dist/render.mjs"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.mts",
      "default": "./dist/plugins/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "tsx playground/index.ts",
    "play:nuxt": "pnpm --filter comark-pdf-playground dev",
    "og:generate": "pnpm --filter comark-pdf-playground og:generate",
    "prepack": "npm run build",
    "release": "release-it",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "comark": ">=0.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "comark": "catalog:",
    "happy-dom": "^20.14.5",
    "release-it": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "pnpm typecheck",
        "pnpm test"
      ]
    },
    "git": {
      "commitMessage": "chore(release): ${npm.name}@${version}",
      "tagName": "${npm.name}@${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": true,
      "releaseName": "${npm.name}@${version}"
    },
    "npm": {
      "publish": true
    }
  },
  "dependencies": {
    "@jasy/pdf": "1.0.0-beta.3"
  }
}
